{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "moduleDetection": "force",
    "types": ["chrome", "node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "test/**/*.mjs"]
}
